<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="simon.ui.MainWindow">
    <!-- Header: anchored to top so it stays visible while content scrolls -->
    <HBox fx:id="headerBox" alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="388.0" spacing="10.0" style="-fx-border-color: transparent transparent #e0e0e0 transparent; -fx-border-width: 0 0 1 0; -fx-padding: 6 10 6 10;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
            <Image url="@/images/simon.png" />
        </ImageView>
        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Simon" />
    </HBox>

    <!-- Scrollable area: placed below header and above the input controls -->
    <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" hvalue="1.0" prefHeight="557.0" prefWidth="400.0" vvalue="1.0" AnchorPane.bottomAnchor="72.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="50.0">
        <VBox fx:id="dialogContainer" prefHeight="477.0" prefWidth="388.0">
            <!-- dialog messages go here -->
        </VBox>
    </ScrollPane>

    <!-- Input area: anchored to bottom as a styled HBox -->
    <HBox fx:id="inputBox" alignment="CENTER_LEFT" spacing="8.0" AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="8.0">
        <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="40.0" promptText="Type a message..." style="-fx-background-color: #f0f0f0; -fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 8 12; -fx-border-color: transparent; -fx-focus-color: derive(#2BC0E5, -20%);" HBox.hgrow="ALWAYS" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" prefHeight="40.0" prefWidth="56.0" style="-fx-background-color: #2BC0E5; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(two-pass-box, rgba(43,192,229,0.24), 6, 0.0, 0, 2);" text="➤" />
    </HBox>
</AnchorPane>
