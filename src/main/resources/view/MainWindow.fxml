<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<?import javafx.scene.image.Image?>
<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="simon.ui.MainWindow">
    <!-- Header: anchored to top so it stays visible while content scrolls -->
    <HBox fx:id="headerBox" spacing="10.0" alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="388.0" style="-fx-border-color: transparent transparent #e0e0e0 transparent; -fx-border-width: 0 0 1 0; -fx-padding: 6 10 6 10;" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
            <Image url="@/images/simon.png" />
        </ImageView>
        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Simon" />
    </HBox>

    <!-- Scrollable area: placed below header and above the input controls -->
    <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" hvalue="1.0" prefHeight="557.0" prefWidth="400.0" vvalue="1.0" AnchorPane.topAnchor="50.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="42.0">
        <VBox fx:id="dialogContainer" prefHeight="552.0" prefWidth="388.0">
            <!-- dialog messages go here -->
        </VBox>
    </ScrollPane>

    <!-- Input area: anchored to bottom -->
    <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="41.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="76.0" AnchorPane.bottomAnchor="1.0" />
    <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" prefHeight="41.0" prefWidth="76.0" text="Send" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="1.0" />
</AnchorPane>
